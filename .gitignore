# secrets: this repo goes public before submission, so nothing sensitive ever lands
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
credentials.json
secrets.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# node
node_modules/
.expo/
dist/
build/
*.tsbuildinfo

# os / editor
.DS_Store
.idea/
.vscode/

# local data. Anchored to the repository root on purpose: an unanchored `data/`
# also matches tv/src/data, which is where the app's description track lives,
# and silently keeps the one file the TV app cannot run without out of the repo.
/data/
/out/
/tmp/

# vega / react native build output
tv/node_modules/
tv/build/
tv/buildinfo.json
tv/dist/
tv/.vega/
*.vpkg
